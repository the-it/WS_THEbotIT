{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "mode": "full",
  "minimumReleaseAge": "14 days",
  "packageRules": [
    {
      "matchPackageNames": [
        "*"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "matchDepNames": [
        "python"
      ],
      "matchManagers": [
        "pep621"
      ],
      "groupName": null,
      "minimumReleaseAge": "90 days"
    }
  ]
}
